APP_ENV=development
TZ=UTC
SERVICE_NAME=example-service
PORT=3000
LOG_LEVEL=info
SERVER_HOST=0.0.0.0
SERVER_IDLE_TIMEOUT_SECONDS=15
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_DRAIN_DELAY_MS=1000
SECURITY_HEADERS_ENABLED=true

# Disabled by default because /metrics should normally be reachable only from
# trusted monitoring/network paths.
METRICS_ENABLED=false
# Required in production when METRICS_ENABLED=true. Use a random value >= 24 chars.
# METRICS_TOKEN=replace-with-runtime-secret

# Development/reference CRUD module. Production startup rejects true.
EXAMPLE_ROUTES_ENABLED=true

OUTBOUND_HTTP_TIMEOUT_MS=5000
OUTBOUND_HTTP_MAX_RETRIES=2
OUTBOUND_HTTP_RETRY_BASE_MS=100

# PostgreSQL is the default baseline.
DB_DRIVER=postgres
DATABASE_URL=postgres://user:password@127.0.0.1:5432/example_service
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_CONNECTION_TIMEOUT_SECONDS=10
DB_MAX_LIFETIME_SECONDS=0
DB_PREPARE=true

# PgBouncer transaction-pooling deployments commonly use:
# DB_PREPARE=false

# Optional Redis worker / background-job pack.
# HTTP-only services can leave this disabled and omit REDIS_URL.
WORKER_ENABLED=false

# Optional dedicated Bun.cron scheduler. Register at least one task before enabling.
SCHEDULER_ENABLED=false
# Default timezone for scheduled tasks; individual tasks may override it.
SCHEDULER_TIMEZONE=UTC
# REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=20
WORKER_QUEUE_NAME=default
WORKER_QUEUE_PREFIX=queue
WORKER_CONCURRENCY=1
WORKER_BLOCK_MS=1000
WORKER_JOB_TIMEOUT_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=1000
WORKER_STALE_AFTER_MS=60000
WORKER_RECLAIM_INTERVAL_MS=15000
