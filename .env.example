APP_ENV=development
TZ=UTC
SERVICE_NAME=example-service
PORT=3000
LOG_LEVEL=info
SERVER_HOST=0.0.0.0
SERVER_IDLE_TIMEOUT_SECONDS=15
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_DRAIN_DELAY_MS=1000
SECURITY_HEADERS_ENABLED=true

METRICS_ENABLED=false
# METRICS_TOKEN=replace-with-runtime-secret
# Worker/scheduler metrics server bind. HTTP app still serves /metrics on PORT.
METRICS_HOST=0.0.0.0
METRICS_PORT=9464
# Loopback-only worker/scheduler liveness and readiness listener.
PROCESS_HEALTH_PORT=9465

EXAMPLE_ROUTES_ENABLED=true

OUTBOUND_HTTP_TIMEOUT_MS=5000
OUTBOUND_HTTP_MAX_RETRIES=2
OUTBOUND_HTTP_RETRY_BASE_MS=100

# MySQL 8 baseline for this branch.
DB_DRIVER=mysql
DATABASE_URL=mysql://user:password@127.0.0.1:3306/example_service
# Optional elevated DDL credential for ./migrate. Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=mysql://migrator:replace-me@127.0.0.1:3306/example_service
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_CONNECTION_TIMEOUT_SECONDS=10
DB_MAX_LIFETIME_SECONDS=0
DB_PREPARE=true
# Use verify-full in staging/production. Set DB_TLS_CA_FILE for a private/custom CA.
DB_TLS_MODE=disable
# DB_TLS_CA_FILE=/run/secrets/mysql-ca.pem

# Development only. Keep false in staging/production.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

WORKER_ENABLED=false
SCHEDULER_ENABLED=false
# Default timezone for scheduled tasks; individual tasks may override it.
SCHEDULER_TIMEZONE=UTC
# REDIS_URL=redis://127.0.0.1:6379
# Defaults to <SERVICE_NAME>:<APP_ENV>. Override for site/cluster isolation when needed.
# REDIS_NAMESPACE=example-service:development:idc1
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=20
WORKER_QUEUE_NAME=default
WORKER_CONCURRENCY=1
WORKER_BLOCK_MS=1000
WORKER_JOB_TIMEOUT_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=1000
WORKER_STALE_AFTER_MS=60000
WORKER_RECLAIM_INTERVAL_MS=15000
