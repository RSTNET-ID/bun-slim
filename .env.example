APP_ENV=development
SERVICE_NAME=example-service
PORT=3000
LOG_LEVEL=info

# PostgreSQL is the default baseline.
DB_DRIVER=postgres
DATABASE_URL=postgres://user:password@127.0.0.1:5432/example_service
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_CONNECTION_TIMEOUT_SECONDS=10
DB_MAX_LIFETIME_SECONDS=0
DB_PREPARE=true

# PgBouncer transaction-pooling deployments commonly use:
# DB_PREPARE=false

# Optional Redis worker / background-job pack.
# HTTP-only services can leave this disabled and omit REDIS_URL.
WORKER_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=20
WORKER_QUEUE_NAME=default
WORKER_QUEUE_PREFIX=queue
WORKER_CONCURRENCY=1
WORKER_BLOCK_MS=1000
WORKER_JOB_TIMEOUT_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=1000
WORKER_STALE_AFTER_MS=60000
WORKER_RECLAIM_INTERVAL_MS=15000
